# Copy this file to .env and fill in real values:  cp .env.example .env

# OpenAI — used by OpenAIEmbeddings and ChatOpenAI
OPENAI_API_KEY=

# Neo4j — used by the neo4j driver / langchain-neo4j
# Aura:  neo4j+s://xxxxxxxx.databases.neo4j.io
# Local: bolt://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
